generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

model User {
  id                 Int                    @id @default(autoincrement())
  seedKey            String?                @unique
  name               String
  email              String                 @unique
  department         String?
  passwordHash       String
  role               Role                   @default(REQUESTER)
  isActive           Boolean                @default(true)
  mustChangePassword Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  requestedTickets   Ticket[]               @relation("TicketRequester")
  ownedTickets       Ticket[]               @relation("TicketOwner")
  uploads            Attachment[]           @relation("AttachmentUploader")
  removals           Attachment[]           @relation("AttachmentRemover")
  comments           Comment[]              @relation("CommentAuthor")
  internalNotes      InternalNote[]         @relation("InternalNoteAuthor")
  performedActions   TicketAction[]         @relation("ActionPerformer")
  assignedActions    TicketAction[]         @relation("ActionAssignee")
  actionRevisions    TicketActionRevision[] @relation("ActionRevisionEditor")
  sessions           Session[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TicketNumberCounter {
  year      Int @id
  lastValue Int
}

model Ticket {
  id                  Int               @id @default(autoincrement())
  seedKey             String?           @unique
  ticketNumber        String            @unique
  summary             String            @db.VarChar(100)
  description         String            @db.VarChar(2000)
  requestedPriority   RequestedPriority @default(MEDIUM)
  itPriority          RequestedPriority
  currentStatus       String            @default("NEW")
  requesterResolved   Boolean           @default(false)
  requesterResolvedAt DateTime?
  workflowVersion     Int               @default(1)
  resolvedAt          DateTime?
  requesterId         Int
  ownerId             Int?
  categoryId          Int
  relatedSystemId     Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  requester           User              @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  owner               User?             @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category            Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem       RelatedSystem     @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments         Attachment[]
  comments            Comment[]
  internalNotes       InternalNote[]
  actions             TicketAction[]

  @@index([requesterId, createdAt(sort: Desc)])
  @@index([requesterId, currentStatus])
  @@index([ownerId, currentStatus])
}

model TicketAction {
  id               Int                    @id @default(autoincrement())
  idempotencyKey   String                 @unique @db.Uuid
  ticketId         Int
  performedById    Int
  assignedToId     Int?
  description      String                 @db.VarChar(2000)
  result           String                 @default("") @db.VarChar(2000)
  followUpRequired Boolean                @default(false)
  followUpNote     String?                @db.VarChar(2000)
  attachmentNotes  String?                @db.VarChar(2000)
  status           ActionStatus           @default(PLANNED)
  version          Int                    @default(1)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  ticket           Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  performedBy      User                   @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  assignedTo       User?                  @relation("ActionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  revisions        TicketActionRevision[]

  @@index([ticketId, createdAt, id])
  @@index([assignedToId, status, updatedAt(sort: Desc)])
  @@index([ticketId, status])
}

model TicketActionRevision {
  id          Int          @id @default(autoincrement())
  actionId    Int
  version     Int
  editedById  Int
  beforeState Json
  afterState  Json
  createdAt   DateTime     @default(now())
  action      TicketAction @relation(fields: [actionId], references: [id], onDelete: Restrict)
  editedBy    User         @relation("ActionRevisionEditor", fields: [editedById], references: [id], onDelete: Restrict)

  @@unique([actionId, version])
  @@index([actionId, createdAt])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFileName String
  storedFileName   String    @unique
  filePath         String
  mimeType         String
  fileSizeBytes    Int
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removedById      Int?
  removalReason    String?   @db.VarChar(255)
  uploadedById     Int
  createdAt        DateTime  @default(now())
  ticket           Ticket    @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  uploadedBy       User      @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  removedBy        User?     @relation("AttachmentRemover", fields: [removedById], references: [id], onDelete: SetNull)

  @@index([ticketId, isRemoved])
}

model Session {
  id        String   @id @db.Uuid
  /// SHA-256 digest of the opaque cookie token; the raw token is never stored.
  token     String   @unique
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Comment {
  id        Int      @id @default(autoincrement())
  seedKey   String?  @unique
  ticketId  Int
  authorId  Int
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  seedKey   String?  @unique
  ticketId  Int
  authorId  Int
  content   String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}
